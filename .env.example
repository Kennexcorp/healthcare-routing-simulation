# Simulation configuration.
#
# Copy to .env to apply, or set any variable inline for a single run:
#   SIM_DEFAULT_THETA=0.60 uv run python main.py --stage simulate
#
# Every value below is a SimulationConfig field (src/config.py). Clinical
# constants (CTMC rates, biometric means, NEWS2 bands, priority weights) are
# NOT configurable and live as module constants in the same file.

# ---------------------------------------------------------------------------
# Full specification profile. These are the SimulationConfig defaults, listed
# here for reference. Leave them commented out to use the defaults. This is the
# profile used for the final results reported in the dissertation.
# ---------------------------------------------------------------------------

# Cohort size calibrated against fleet capacity: 160 patients leaves the fleet
# reaching 87.5% of the cohort per shift, near but under capacity.
# SIM_N_PATIENTS=160
# SIM_N_WORKERS=10
# SIM_SHIFT_DURATION_MINS=480
# SIM_TIMESTEP_MINS=5
# SIM_CITY_RADIUS_KM=10.0
# SIM_TRAVEL_SPEED_KMH=30.0
# SIM_SERVICE_DURATION_MINS=30

# AND-gate trigger
# SIM_DEFAULT_THETA=0.70
# SIM_DEFAULT_TAU=60

# OR-Tools solver time limits (seconds)
# SIM_INITIAL_SOLVE_LIMIT=30
# SIM_REROUTE_SOLVE_LIMIT=10

# Replications
# SIM_INITIAL_BATCH_REPS=10
# SIM_TARGET_PRECISION=0.10
# SIM_CONFIDENCE_LEVEL=0.95

# Replications per sensitivity setting. Deliberately separate from
# SIM_INITIAL_BATCH_REPS: the sweep runs seven settings, so tying the two
# together multiplies the whole experiment by seven.
# SIM_SENSITIVITY_REPS=10

# ML training corpus and hyperparameter search
# SIM_N_TRAINING_SHIFTS=5
# SIM_TRAINING_SEED_BASE=90000
# SIM_SEARCH_N_ITER=50

# How far ahead the classifier predicts. The training target is the patient's
# NEWS2 class this many minutes in the future, not their current one.
# SIM_PREDICTION_LEAD_TIME_MINS=30

# ---------------------------------------------------------------------------
# Smoke profile for development and testing.
#
# A full run is 96 timesteps by 3 scenarios by N replications with a 10-second
# OR-Tools re-solve on every trigger batch, plus a 50-iteration hyperparameter
# search across three classifiers. Never iterate at that scale. Uncomment the
# block below, or paste it inline.
#
# Results produced under this profile are NOT dissertation artefacts and must
# be regenerated at full scale.
# ---------------------------------------------------------------------------

# SIM_N_PATIENTS=20
# SIM_N_WORKERS=2
# SIM_INITIAL_BATCH_REPS=5
# SIM_INITIAL_SOLVE_LIMIT=5
# SIM_REROUTE_SOLVE_LIMIT=2
# SIM_N_TRAINING_SHIFTS=1
# SIM_SEARCH_N_ITER=5
# SIM_SENSITIVITY_REPS=2
